noextract=(
  'tokenizer.json'
  'text_model.onnx'
  'vision_model.onnx'
  'det_500m.onnx'
  'w600k_mbf.onnx'
  'ffmpeg-x86_64-unknown-linux-gnu'
  'ffprobe-x86_64-unknown-linux-gnu'
)

prepare() {
  local root="${srcdir}/lap-${_commit}"
  local third="${root}/src-tauri/third_party"
  patch -p1 -d "${root}" -i "${srcdir}/disable-updater.patch"
  patch -p1 -d "${root}" -i "${srcdir}/fix-optional-aptabase-exit.patch"
  rm -rf \
    "${third}/LibRaw" \
    "${third}/libde265" \
    "${third}/libheif" \
    "${third}/libjpeg-turbo"
  mv "${srcdir}/LibRaw-${_libraw}" "${third}/LibRaw"
  mv "${srcdir}/libde265-${_libde265}" "${third}/libde265"
  mv "${srcdir}/libheif-${_libheif}" "${third}/libheif"
  mv "${srcdir}/libjpeg-turbo-${_libjpegturbo}" "${third}/libjpeg-turbo"

  install -d "${root}/src-tauri/resources/models" "${root}/src-tauri/resources/ffmpeg"
  install -m644 \
    "${srcdir}/tokenizer.json" \
    "${srcdir}/text_model.onnx" \
    "${srcdir}/vision_model.onnx" \
    "${srcdir}/det_500m.onnx" \
    "${srcdir}/w600k_mbf.onnx" \
    "${root}/src-tauri/resources/models/"
  install -m755 \
    "${srcdir}/ffmpeg-x86_64-unknown-linux-gnu" \
    "${srcdir}/ffprobe-x86_64-unknown-linux-gnu" \
    "${root}/src-tauri/resources/ffmpeg/"
}

build() {
  local root="${srcdir}/lap-${_commit}"
  export VITE_LAP_PACKAGE_MANAGER=pacman
  export XDG_CACHE_HOME="${srcdir}/ort-cache"
  export ORT_STRATEGY=download
  unset ORT_SKIP_DOWNLOAD ORT_LIB_LOCATION
  pnpm --dir "${root}/src-vite" install --frozen-lockfile
  pnpm --dir "${root}/src-vite" build
  cd "${root}/src-tauri"
  cargo tauri build --bundles deb --config '{"build":{"beforeBuildCommand":""},"bundle":{"createUpdaterArtifacts":false}}'
}

package() {
  local root="${srcdir}/lap-${_commit}"
  local deb
  deb="$(find "${root}/src-tauri/target/release/bundle/deb" -name '*.deb' -print -quit)"
  test -n "${deb}"
  local data
  data="$(bsdtar -tf "${deb}" | awk '/^data\.tar/ { print; exit }')"
  test -n "${data}"
  bsdtar -xOf "${deb}" "${data}" | bsdtar --no-same-owner -x -C "${pkgdir}"
  install -Dm644 "${srcdir}/package-source-license" \
    "${pkgdir}/usr/share/licenses/${pkgname}/package-source-license"
  if [[ ! -e "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" ]]; then
    install -Dm644 "${root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi
  if [[ ! -e "${pkgdir}/usr/share/applications/lap.desktop" && ! -e "${pkgdir}/usr/share/applications/Lap.desktop" ]]; then
    install -Dm644 "${srcdir}/lap.desktop" "${pkgdir}/usr/share/applications/lap.desktop"
  fi
}
