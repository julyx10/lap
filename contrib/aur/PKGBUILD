pkgname=lap
pkgver=0.3.2
pkgrel=2
pkgdesc='Offline-first photo manager for large local libraries'
arch=('x86_64')
url='https://julyx10.github.io/lap'
license=('GPL-3.0-or-later')
depends=(
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libappindicator' # tray icon is dlopen'd; not a DT_NEEDED entry
  'libgcc'
  'librsvg'
  'libstdc++'
  'openssl'
  'webkit2gtk-4.1'
)
makedepends=(
  'cargo-tauri'
  'clang'
  'cmake'
  'git'
  'nasm'
